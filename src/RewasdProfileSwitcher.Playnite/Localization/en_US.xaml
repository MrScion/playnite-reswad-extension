<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Settings: intro -->
    <sys:String x:Key="LOCRewasdSettingsHeader">reWASD Profile Switcher</sys:String>
    <sys:String x:Key="LOCRewasdSettingsHint">Automatically switches your reWASD gamepad profile(s) when a game starts and stops. Off by default — leave it off if you play with keyboard/mouse.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsEnable">Enable automatic profile switching</sys:String>

    <!-- Settings: CLI -->
    <sys:String x:Key="LOCRewasdSettingsCliHeader">reWASD command-line tool</sys:String>
    <sys:String x:Key="LOCRewasdSettingsBrowse">Browse...</sys:String>
    <sys:String x:Key="LOCRewasdCliFilter">reWASDCommandLine.exe|reWASDCommandLine.exe|Executable files|*.exe</sys:String>

    <!-- Settings: devices -->
    <sys:String x:Key="LOCRewasdSettingsDevicesHeader">Devices</sys:String>
    <sys:String x:Key="LOCRewasdSettingsDevicesHint">One entry per gamepad you want managed. Each device switches independently when any game starts or stops.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsAddDevice">+ Add device</sys:String>
    <sys:String x:Key="LOCRewasdSettingsRemoveDevice">- Remove device</sys:String>
    <sys:String x:Key="LOCRewasdNewDeviceName">New device</sys:String>

    <!-- Settings: selected device -->
    <sys:String x:Key="LOCRewasdSettingsDeviceNameLabel">Name</sys:String>
    <sys:String x:Key="LOCRewasdSettingsDeviceIdLabel">Device ID</sys:String>
    <sys:String x:Key="LOCRewasdSettingsDeviceIdHint">"Copy device ID" in reWASD.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsSlotLabel">Slot</sys:String>

    <sys:String x:Key="LOCRewasdSettingsDefaultProfileHeader">Default profile</sys:String>
    <sys:String x:Key="LOCRewasdSettingsDefaultProfileHint">Applied when any game closes, and as the fallback when a running game's library has no profile of its own below.</sys:String>
    <sys:String x:Key="LOCRewasdProfileFilter">reWASD profile|*.rewasd|All files|*.*</sys:String>
    <sys:String x:Key="LOCRewasdSettingsTestDefault">Test default profile now</sys:String>

    <sys:String x:Key="LOCRewasdSettingsLibraryProfilesHeader">Per-library profiles (optional)</sys:String>
    <sys:String x:Key="LOCRewasdSettingsLibraryProfilesHint">Override the default profile for games from one specific Playnite library — e.g. one profile for Steam, another for a different library.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsAddLibraryProfile">+ Add library profile...</sys:String>
    <sys:String x:Key="LOCRewasdSettingsRemove">Remove</sys:String>
    <sys:String x:Key="LOCRewasdSettingsTest">Test</sys:String>

    <sys:String x:Key="LOCRewasdLibraryPickerCaption">Pick a library</sys:String>
    <sys:String x:Key="LOCRewasdNoLibrariesFound">No libraries found — add at least one game to your Playnite library first.</sys:String>
    <sys:String x:Key="LOCRewasdNoLibraryLabel">Manually added games (no library)</sys:String>

    <!-- Test result messages -->
    <sys:String x:Key="LOCRewasdTestOk">Profile applied successfully.</sys:String>
    <sys:String x:Key="LOCRewasdTestErrorPrefix" xml:space="preserve">Error: </sys:String>

</ResourceDictionary>
