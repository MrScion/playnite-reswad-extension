<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Settings: tabs -->
    <sys:String x:Key="LOCRewasdSettingsTabGeneral">General</sys:String>
    <sys:String x:Key="LOCRewasdSettingsTabDevices">Devices</sys:String>
    <sys:String x:Key="LOCRewasdSettingsTabProfiles">Profiles</sys:String>

    <!-- Settings: intro -->
    <sys:String x:Key="LOCRewasdSettingsHeader">reWASD Profile Switcher</sys:String>
    <sys:String x:Key="LOCRewasdSettingsHint">Automatically switches your reWASD gamepad profile(s) when a game starts and stops. Off by default — leave it off if you play with keyboard/mouse.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsEnable">Enable automatic profile switching</sys:String>

    <!-- Settings: install folder -->
    <sys:String x:Key="LOCRewasdSettingsInstallFolderHeader">reWASD installation folder</sys:String>
    <sys:String x:Key="LOCRewasdSettingsInstallFolderHint">Defaults to reWASD's standard install location. Change it if you installed reWASD somewhere else — the command-line tool path below is then detected automatically.</sys:String>

    <!-- Settings: CLI -->
    <sys:String x:Key="LOCRewasdSettingsCliHeader">reWASD command-line tool</sys:String>
    <sys:String x:Key="LOCRewasdSettingsCliHint">Auto-detected from the installation folder above. Only browse for it manually if auto-detection didn't find it.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsBrowse">Browse...</sys:String>
    <sys:String x:Key="LOCRewasdCliFilter">reWASDCommandLine.exe|reWASDCommandLine.exe|Executable files|*.exe</sys:String>

    <!-- Settings: profiles folder -->
    <sys:String x:Key="LOCRewasdSettingsProfilesFolderHeader">reWASD profiles folder</sys:String>
    <sys:String x:Key="LOCRewasdSettingsProfilesFolderHint">Optional. Point this at the folder containing reWASD's "Profiles" subfolder (each profile has its own folder there, with a Controller subfolder holding its .rewasd file(s)). Once set, the Profiles tab lets you pick from the .rewasd files found there instead of browsing the file system by hand.</sys:String>
    <sys:String x:Key="LOCRewasdProfileFilePickerCaption">Pick a reWASD profile, or browse manually</sys:String>
    <sys:String x:Key="LOCRewasdProfileFileBrowseManually">Browse manually (pick a .rewasd file)</sys:String>

    <!-- Settings: devices -->
    <sys:String x:Key="LOCRewasdSettingsDevicesHeader">Devices</sys:String>
    <sys:String x:Key="LOCRewasdSettingsDevicesHint">One entry per gamepad you want managed. Each device switches independently when any game starts or stops.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsAddDevice">+ Add device</sys:String>
    <sys:String x:Key="LOCRewasdSettingsRemoveDevice">- Remove device</sys:String>
    <sys:String x:Key="LOCRewasdNewDeviceName">New device</sys:String>
    <sys:String x:Key="LOCRewasdDevicePickerCaption">Pick a detected gamepad, or add one manually</sys:String>
    <sys:String x:Key="LOCRewasdAddDeviceManually">Add manually (type the name in yourself)</sys:String>

    <!-- Settings: selected device -->
    <sys:String x:Key="LOCRewasdSettingsSelectedDeviceHeader">Selected device</sys:String>
    <sys:String x:Key="LOCRewasdSettingsDeviceNameLabel">Name</sys:String>
    <sys:String x:Key="LOCRewasdSettingsDeviceIdLabel">Device ID</sys:String>
    <sys:String x:Key="LOCRewasdSettingsDeviceIdHint">"Copy device ID" in reWASD.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsSlotLabel">Slot</sys:String>

    <!-- Settings: profiles tab -->
    <sys:String x:Key="LOCRewasdSettingsProfilesHeader">Profiles</sys:String>
    <sys:String x:Key="LOCRewasdSettingsProfilesHint">Pick a device in the Devices tab first — its profiles are configured here.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsNoDeviceSelected">No device selected — go to the Devices tab first.</sys:String>
    <sys:String x:Key="LOCRewasdSettingsEditingDeviceFormat">Editing profiles for: {0}</sys:String>

    <sys:String x:Key="LOCRewasdSettingsDefaultProfileHeader">Default profile</sys:String>
    <sys:String x:Key="LOCRewasdSettingsDefaultProfileHint">Applied when any game closes, and as the fallback when a running game's library has no profile of its own below.</sys:String>
    <sys:String x:Key="LOCRewasdProfileFilter">reWASD profile|*.rewasd|All files|*.*</sys:String>
    <sys:String x:Key="LOCRewasdSettingsTestDefault">Test default profile now</sys:String>

    <sys:String x:Key="LOCRewasdSettingsLibraryProfilesHeader">Per-library profiles (optional)</sys:String>
    <sys:String x:Key="LOCRewasdSettingsLibraryProfilesHint">Override the default profile for games from one specific Playnite library — e.g. one profile for Steam, another for a different library. A library can also be set to Passthrough, which turns remap off instead — releasing reWASD's virtual controller so the real physical device is visible to that library as-is (e.g. so Steam Input sees an actual Steam Controller instead of a virtual Xbox 360 pad).</sys:String>
    <sys:String x:Key="LOCRewasdSettingsAddLibraryProfile">+ Add library profile...</sys:String>
    <sys:String x:Key="LOCRewasdSettingsRemove">Remove</sys:String>
    <sys:String x:Key="LOCRewasdSettingsTest">Test</sys:String>
    <sys:String x:Key="LOCRewasdSettingsLibraryPassthroughLabel">Passthrough</sys:String>
    <sys:String x:Key="LOCRewasdSettingsLibraryPassthroughHint">Real device shown as-is — no profile.</sys:String>

    <sys:String x:Key="LOCRewasdLibraryPickerCaption">Pick a library</sys:String>
    <sys:String x:Key="LOCRewasdLibraryModePickerCaption">How should this library be handled?</sys:String>
    <sys:String x:Key="LOCRewasdLibraryModeProfile">Use a profile file</sys:String>
    <sys:String x:Key="LOCRewasdLibraryModePassthrough">Passthrough — turn remap off, show the real device as-is</sys:String>
    <sys:String x:Key="LOCRewasdNoLibrariesFound">No libraries found — add at least one game to your Playnite library first.</sys:String>
    <sys:String x:Key="LOCRewasdNoLibraryLabel">Manually added games (no library)</sys:String>

    <!-- Test result messages -->
    <sys:String x:Key="LOCRewasdTestOk">Profile applied successfully.</sys:String>
    <sys:String x:Key="LOCRewasdTestPassthroughOk">Remap turned off — the real device should now be visible as-is.</sys:String>
    <sys:String x:Key="LOCRewasdTestErrorPrefix" xml:space="preserve">Error: </sys:String>

</ResourceDictionary>
